        {"id": "v0", "x": 0, "y": 0, "cpu": 6},
        {"id": "v1", "x": 10, "y": 0, "cpu": 4},
        {"id": "v2", "x": 20, "y": 0, "cpu": 10},
        {"id": "v3", "x": 90, "y": 0, "cpu": 8},
        {"id": "v4", "x": 100, "y": 0, "cpu": 7}
      ],
      "edges": [
        {"u": "v0", "v": "v1", "bandwidth": 5, "delay": 1},
        {"u": "v1", "v": "v2", "bandwidth": 5, "delay": 1},
        {"u": "v2", "v": "v3", "bandwidth": 5, "delay": 5},
        {"u": "v3", "v": "v4", "bandwidth": 5, "delay": 1}
