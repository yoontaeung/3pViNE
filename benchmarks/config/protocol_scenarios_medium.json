      },
      {
        "facility_id": "facility-B",
        "inp_id": 1,
        "global_node_base": 100,
        "coordinate_x": 100,
        "endpoint_id": "endpoint-B"
      }
    ],
    "substrate_topology": {
      "type": "full_mesh",
      "node_count": 10,
      "bandwidth": 100,
      "delay": 1
